<root main_tree_to_execute="MainTree">
   <BehaviorTree ID="MainTree">

       <Fallback name="GoalkeeperStrategy">

           <Sequence name="EmergencyDefense">

               <IsBallCloseCondition robot_id="{robot_id}" ball_x="{ball_x}" ball_y="{ball_y}" />

               <SmotherSaveNode robot_id="{robot_id}" ball_x="{ball_x}" ball_y="{ball_y}" />

           </Sequence>

           <PositionBisectorNode robot_id="{robot_id}" ball_x="{ball_x}" ball_y="{ball_y}" goal_width="{goal_width}" />

       </Fallback>

   </BehaviorTree>
</root>