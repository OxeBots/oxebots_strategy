<?xml version="1.0"?>
<!--
  falta, lateral, escanteio e tiro de meta chegam
  todos como DIRECT_FREE (fase FREE_KICK).
  - FreeKickOurTree (SC-07): cobrador (kicker) executa RestartKickerTree; apoio vai a >= 0,2 m da área adversária.
  - FreeKickTheirTree (SC-08): robôs de linha formam barreira (wall) a >= 0,5 m da bola; goleiro defende meta.
-->
<root BTCPP_format="4">

  <!-- Free kick nosso: cobrança e apoio legal (SC-07) -->
  <BehaviorTree ID="FreeKickOurTree">
    <ReactiveFallback name="FreeKickOurRoles">
      <ReactiveSequence name="GoalkeeperRole">
        <HasRole role="goalkeeper"/>
        <SubTree ID="GoalkeeperTree" _autoremap="true"/>
      </ReactiveSequence>

      <ReactiveSequence name="KickerRole">
        <HasRole role="kicker"/>
        <SubTree ID="RestartKickerTree" _autoremap="true" target_x="{opp_goal_x}" target_y="{opp_goal_y}"/>
      </ReactiveSequence>

      <ReactiveSequence name="SupportRole">
        <ComputeLegalSlot slot="freekick_support" index="0" slot_x="{slot_x}" slot_y="{slot_y}"/>
        <GoToPoint robot_id="{robot_id}" x="{slot_x}" y="{slot_y}" face_x="{ball_x}" face_y="{ball_y}" tolerance="80.0"/>
      </ReactiveSequence>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Free kick adversário: barreira legal a >= 0.5m da bola (SC-08) -->
  <BehaviorTree ID="FreeKickTheirTree">
    <ReactiveFallback name="FreeKickTheirRoles">
      <ReactiveSequence name="GoalkeeperRole">
        <HasRole role="goalkeeper"/>
        <SubTree ID="GoalkeeperTree" _autoremap="true"/>
      </ReactiveSequence>

      <ReactiveSequence name="WallRole">
        <ComputeLegalSlot slot="wall" index="0" slot_x="{slot_x}" slot_y="{slot_y}"/>
        <GoToPoint robot_id="{robot_id}" x="{slot_x}" y="{slot_y}" face_x="{ball_x}" face_y="{ball_y}" tolerance="80.0"/>
      </ReactiveSequence>
    </ReactiveFallback>
  </BehaviorTree>

</root>
