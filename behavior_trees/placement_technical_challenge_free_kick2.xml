<root BTCPP_format="4">
    <BehaviorTree ID="Desafio2">
        <Fallback>
            
            <!-- ============================================== -->
            <!-- FASE DE EXECUÇÃO (Comando Ativo)               -->
            <!-- ============================================== -->
            <Sequence>
                <CheckGCCommand expected="8"/> 
                
                <Fallback>
                    
                    <!-- ROBÔ ID 0: Alvo (-1850, 1420) | Orientação 270° (Olhando para baixo) -->
                    <Sequence>
                        <IsThisNodeID id="0"/>
                        <GoToPoint robot_id="0" x="-1350" y="1420" face_x="-1850" face_y="420" tolerance="50.0" ignore_area="true"/>
                        <Repeat num_cycles="-1">
                            <GoToPoint robot_id="0" x="-1850" y="1420" face_x="-1850" face_y="420" tolerance="50.0" ignore_area="true"/>
                        </Repeat>
                    </Sequence>

                    <!-- ROBÔ ID 1: Alvo (150, 700) | Orientação 180° (Olhando para a esquerda) -->
                    <Sequence>
                        <IsThisNodeID id="1"/>
                        <Repeat num_cycles="-1">
                            <GoToPoint robot_id="1" x="150" y="700" face_x="-850" face_y="700" tolerance="50.0"/>
                        </Repeat>
                    </Sequence>

                    <!-- ROBÔ ID 2: Alvo (-590, -600) | Orientação 180° (Olhando para a esquerda) -->
                    <Sequence>
                        <IsThisNodeID id="2"/>
                        <Repeat num_cycles="-1">
                            <GoToPoint robot_id="2" x="-590" y="-600" face_x="-1590" face_y="-600" tolerance="50.0"/>
                        </Repeat>
                    </Sequence>
                    
                    <!-- DEMAIS ROBÔS ESTÁTICOS -->
                    <Repeat num_cycles="-1">
                        <Sequence><Halt reason="assistindo"/><Sleep msec="100"/></Sequence>
                    </Repeat>

                </Fallback>
            </Sequence>


            <!-- ESTADO INATIVO -->
            <Sequence>
                <Halt reason="aguardando_juiz"/>
            </Sequence>

        </Fallback>
    </BehaviorTree>
</root>