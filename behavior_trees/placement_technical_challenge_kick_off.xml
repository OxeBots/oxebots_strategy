<root BTCPP_format="4">
    <BehaviorTree ID="Desafio3">
        <Fallback>
            
            <ReactiveSequence>
                <IsNormalFreeKick/> 
                
                <Fallback>
                    
                    <!-- ROBÔ ID 0 -->
                    <Sequence>
                        <IsThisNodeID id="0"/>
                        <GoToPoint robot_id="0" x="-500" y="-1000" face_x="1000" face_y="-1300" tolerance="50.0"/>
                        <Repeat num_cycles="-1">
                            <GoToPoint robot_id="0" x="2100" y="0" face_x="1100" face_y="0" tolerance="50.0"/>
                        </Repeat>
                    </Sequence>

                    <!-- ROBÔ ID 1 -->
                    <Sequence>
                        <IsThisNodeID id="1"/>
                        <!-- Contorna o centro por cima -->
                        <GoToPoint robot_id="1" x="-700" y="1200" face_x="250" face_y="700" tolerance="50.0"/>
                        <!-- Alvo final travado -->
                        <Repeat num_cycles="-1">
                            <GoToPoint robot_id="1" x="250" y="700" face_x="-750" face_y="700" tolerance="50.0"/>
                        </Repeat>
                    </Sequence>

                    <!-- ROBÔ ID 2 -->
                    <Sequence>
                        <IsThisNodeID id="2"/>
                        <GoToPoint robot_id="2" x="-100" y="800" face_x="250" face_y="0" tolerance="50.0"/>
                        <Repeat num_cycles="-1">
                            <GoToPoint robot_id="2" x="250" y="0" face_x="-750" face_y="0" tolerance="50.0"/>
                        </Repeat>
                    </Sequence>
                    
                    <!-- DEMAIS ROBÔS ESTÁTICOS -->
                    <Repeat num_cycles="-1">
                        <Sequence><Halt reason="assistindo"/><Sleep msec="100"/></Sequence>
                    </Repeat>

                </Fallback>
            </ReactiveSequence>

            <Sequence>
                <Halt reason="aguardando_juiz"/>
            </Sequence>

        </Fallback>
    </BehaviorTree>
</root>