<root main_tree_to_execute="DefenderTree" BTCPP_format="4">
  <BehaviorTree ID="DefenderTree">

    <Sequence name="SelectedDefenderOnly">
      <IsMyRole role="defender"/>

      <ReactiveFallback name="Root">

        <!-- ============================================================ -->
        <!-- Estágio 1: Bola no campo adversário                          -->
        <!-- Zagueiro acompanha bola prevista a distância fixa,           -->
        <!-- nunca cruza o meio-campo e nunca entra na pequena área       -->
        <!-- ============================================================ -->
        <Sequence name="BallInOpponentField">
          <IsBallInOpponentField ball_x="{ball_x}" is_yellow="{is_yellow}"/>
          <ShadowBall
            ball="{ball}"
            ball_vel="{ball_vel}"
            my_goal_x="{my_goal_x}"/>
        </Sequence>

        <!-- ============================================================ -->
        <!-- Estágio 2: Bola no nosso campo                               -->
        <!-- ============================================================ -->
        <ReactiveFallback name="BallInOurField">

          <!-- 2.1: Oponente com posse de bola                            -->
          <!-- Marca o oponente: posiciona entre bola e gol a dist. fixa  -->
          <!-- Nunca avança sobre o oponente, nunca entra na pequena área  -->
          <Sequence name="OpponentHasPossession">
            <IsOpponentControllingBall opponent_controlling="{opponent_controlling}"/>
            <MarkOpponent ball="{ball}" my_goal_x="{my_goal_x}"/>
          </Sequence>

          <!-- 2.2: Oponente sem posse de bola                            -->
          <!-- Ir até a bola e chutar em direção ao gol adversário        -->
          <!-- Padrão: GoToPoint em paralelo com espera IsBallClose+Kick  -->
          <Parallel success_count="1" failure_count="1" name="ClearBall">

            <!-- Empurra o robô continuamente em direção à bola (com clamp da pequena área) -->
            <GoToClamped x="{ball_x}" y="{ball_y}" my_goal_x="{my_goal_x}"/>

            <!-- Quando chegar perto o suficiente, chuta                  -->
            <Sequence>
              <RetryUntilSuccessful num_attempts="-1">
                <IsBallClose robot_id="{robot_id}" distance_threshold="140.0"/>
              </RetryUntilSuccessful>
              <KickBall robot_id="{robot_id}" kick_speed="6.5"/>
            </Sequence>

          </Parallel>

        </ReactiveFallback>

      </ReactiveFallback>

    </Sequence>

  </BehaviorTree>
</root>