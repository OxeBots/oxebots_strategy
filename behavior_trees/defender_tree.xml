<root main_tree_to_execute="DefenderTree" BTCPP_format="4">
  <!--
    E10 — árvore do defensor, agnóstica de lado e de cor.
     - O papel é verificado com HasRole (blackboard), em uma ReactiveSequence: o defensor é
       interrompido no tick em que perde o papel e assume no mesmo tick em que ganha.
     - "Campo adversário" é decidido por my_goal_x (do GameState / geometria), não pela cor do
       time: na troca de lados (segundo tempo) a árvore continua certa sem alteração.
     - Todos os alvos do defensor ficam FORA da pequena área própria (margem de 200 mm). Só o
       goleiro pode estar na própria área (R-22); sem profundidade da área o nó falha em vez de
       supor um valor (SC-17).
     - Defensor agressivo na metade defensiva (Estágio 2.0): sempre que a bola está no nosso
       campo e fora da pequena área do goleiro, o zagueiro vai direto na bola para dar o bote,
       passar para um aliado livre ou afastar firme (<= 3,0 m/s). Só recua para cobertura
       (MarkOpponent / ShadowBall) se a bola estiver dentro da pequena área do goleiro ou se
       nosso próprio atacante já estiver colado dominando a bola.
  -->
  <BehaviorTree ID="DefenderTree">

    <ReactiveSequence name="SelectedDefenderOnly">
      <HasRole role="defender"/>

      <ReactiveFallback name="Root">

        <!-- ============================================================ -->
        <!-- Estágio 1: Bola no campo adversário                          -->
        <!-- Zagueiro cobre o contra-ataque (coordenado com o goleiro     -->
        <!-- e interceptando chutes diretos), fora da área e no seu campo -->
        <!-- ============================================================ -->
        <ReactiveSequence name="BallInOpponentField">
          <IsBallInOpponentField ball_x="{ball_x}" my_goal_x="{my_goal_x}"/>
          <ShadowBall
            ball="{ball}"
            ball_vel="{ball_vel}"
            my_goal_x="{my_goal_x}"/>
        </ReactiveSequence>

        <!-- ============================================================ -->
        <!-- Estágio 2: Bola no nosso campo (zona do zagueiro)            -->
        <!-- ============================================================ -->
        <ReactiveFallback name="BallInOurField">

          <!-- 2.0: Bola no nosso campo fora da pequena área do goleiro   -->
          <!-- Zagueiro AGRESSIVO: vai na bola para passe ou chute p/fora -->
          <ReactiveSequence name="AggressiveClearOrPass">
            <Inverter>
              <IsBallInArea ball_x="{ball_x}" ball_y="{ball_y}"/>
            </Inverter>
            <Sequence name="DefenderEngageAndKick">
              <DefenderClear
                robot_id="{robot_id}"
                ball_x="{ball_x}"
                ball_y="{ball_y}"
                my_goal_x="{my_goal_x}"
                kick_speed="{def_kick_speed}"/>
              <KickBall robot_id="{robot_id}" kick_speed="{def_kick_speed}"/>
            </Sequence>
          </ReactiveSequence>

          <!-- 2.1: Fallback (bola na área do goleiro ou atacante na bola)-->
          <ReactiveSequence name="OpponentHasPossession">
            <IsOpponentControllingBall opponent_controlling="{opponent_controlling}"/>
            <MarkOpponent ball="{ball}" my_goal_x="{my_goal_x}"/>
          </ReactiveSequence>

          <!-- 2.2: Cobertura do ângulo do gol fora da área               -->
          <ShadowBall
            ball="{ball}"
            ball_vel="{ball_vel}"
            my_goal_x="{my_goal_x}"
            ratio="0.35"/>

        </ReactiveFallback>

      </ReactiveFallback>

    </ReactiveSequence>

  </BehaviorTree>
</root>
