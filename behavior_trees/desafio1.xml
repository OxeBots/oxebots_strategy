<root BTCPP_format="4">
    <BehaviorTree ID="Desafio1">
        <Sequence>
            <IsNormalFreeKick/>
            <CheckGCCommand expected="2"/>

            <Parallel success_threshold="2" failure_threshold="1">
                <GoToPoint robot_id="1" x="{-200}" y="{-1400}"/>
                <GoToPoint robot_id="2" x="{pkx}" y="{pky}"/>
            </Parallel>

            <AimAt robot_id="1" target_x="{pkx}" target_y="{pky}"/>
            <KickBall robot_id="1" kick_speed="4.5"/>


            <AimAt robot_id="2" target_x="-2175" target_y="0"/>
            <KickBall robot_id="2" kick_speed="6.5"/>

        </Sequence>
    </BehaviorTree>

</root>