<root BTCPP_format="4" main_tree_to_execute="Desafio4">  
    <BehaviorTree ID="Desafio4">  
        <ReactiveFallback>
            
            <!-- ============================================== -->
            <!-- FASE DE EXECUÇÃO (A SUA JOGADA ORIGINAL)       -->
            <!-- ============================================== -->
            <ReactiveSequence>  
                <CheckGCCommand expected="8"/>  
                  
                <Fallback>  
                      
                    <!-- ============================================== -->  
                    <!-- ROBÔ 1 (O CRUZADOR / WINGER)                   -->  
                    <!-- ============================================== -->  
                    <Sequence>  
                        <IsThisNodeID id="1"/>  
                          
                        <UpdateBallPosition robot_id="1" goal_x="-1120" goal_y="40"   
                                            ball_x="{bx1}" ball_y="{by1}" pre_kick_x="{pkx1}" pre_kick_y="{pky1}"   
                                            is_ready_to_kick="{dummy_ready}" ball_in_enemy_half="{dummy_adv}"/>  
                          
                        <GoToPoint robot_id="1" x="{pkx1}" y="{pky1}" face_x="-1120" face_y="40" tolerance="100.0"/>  
                          
                        <RetryUntilSuccessful num_attempts="-1">  
                            <ReactiveFallback>  
                                <Sequence>  
                                    <IsBallClose robot_id="1" distance_threshold="125.0" angle_threshold_deg="15.0"/>  
                                    <!-- Passe cadenciado na direção do corpo do Robô 2 para amortecer e parar -->
                                    <KickBall robot_id="1" kick_speed="2.3"/>  
                                </Sequence>  
                                <Sequence>  
                                    <UpdateBallPosition robot_id="1" goal_x="-1120" goal_y="40"   
                                                        ball_x="{bx1}" ball_y="{by1}" pre_kick_x="{dummy_x1}" pre_kick_y="{dummy_y1}"   
                                                        is_ready_to_kick="{dummy_ready1}" ball_in_enemy_half="{dummy_adv1}"/>  
                                    <GoToPoint robot_id="1" x="{bx1}" y="{by1}" face_x="-1120" face_y="40" tolerance="0.0" planner="straight_line"/>  
                                </Sequence>  
                            </ReactiveFallback>  
                        </RetryUntilSuccessful>  
                          
                        <Repeat num_cycles="-1">  
                            <Sequence>  
                                <Halt reason="cruzamento_concluido"/>  
                                <Sleep msec="100"/>  
                            </Sequence>  
                        </Repeat>  
                    </Sequence>  

                    <!-- ============================================== -->  
                    <!-- ROBÔ 2 (O PIVÔ PACIENTE NA GRANDE ÁREA)        -->  
                    <!-- ============================================== -->  
                    <Sequence>  
                        <IsThisNodeID id="2"/>  
                          
                        <!-- FASE 1: OBRIGA o robô a chegar na sua base (-1200, 0) ANTES de ligar o radar de bola -->  
                        <RetryUntilSuccessful num_attempts="-1">  
                            <Sequence>  
                                <UpdateBallPosition robot_id="2" goal_x="-2175" goal_y="0" ball_x="{bx2}" ball_y="{by2}" pre_kick_x="{dummy_x}" pre_kick_y="{dummy_y}" is_ready_to_kick="{dummy_r}" ball_in_enemy_half="{dummy_a}"/>  
                                <GoToPoint robot_id="2" x="-1200" y="0" face_x="{bx2}" face_y="{by2}" tolerance="100.0"/>  
                            </Sequence>  
                        </RetryUntilSuccessful>  
                          
                        <!-- FASE 2: RADAR LIGADO! Espera a bola chegar perto (< 600mm), para com o corpo e aguarda 2s -->  
                        <RetryUntilSuccessful num_attempts="-1">  
                            <ReactiveSequence>  
                                <UpdateBallPosition robot_id="2" goal_x="-2175" goal_y="0"   
                                                    ball_x="{bx2}" ball_y="{by2}" pre_kick_x="{dummy_x}" pre_kick_y="{dummy_y}"   
                                                    is_ready_to_kick="{dummy_ready}" ball_in_enemy_half="{dummy_adv}"/>  
                                <ReactiveFallback>  
                                    <Sequence>  
                                        <!-- Ignora o ângulo com 360.0 para garantir o disparo se a bola encostar -->  
                                        <IsBallClose robot_id="2" distance_threshold="600.0" angle_threshold_deg="360.0"/>  
                                        <Sleep msec="2000"/>  
                                    </Sequence>  
                                    <Sequence>  
                                        <GoToPoint robot_id="2" x="-1200" y="0" face_x="{bx2}" face_y="{by2}" tolerance="100.0"/>  
                                        <AlwaysFailure/>  
                                    </Sequence>  
                                </ReactiveFallback>  
                            </ReactiveSequence>  
                        </RetryUntilSuccessful>  
                          
                        <!-- FASE 3: A bola parou! Lê a posição final dela, alinha no pré-chute e chuta pro gol -->  
                        <UpdateBallPosition robot_id="2" goal_x="-2175" goal_y="0"   
                                            ball_x="{bx_final}" ball_y="{by_final}" pre_kick_x="{pkx_final}" pre_kick_y="{pky_final}"   
                                            is_ready_to_kick="{dummy_r}" ball_in_enemy_half="{dummy_a}"/>  
                          
                        <GoToPoint robot_id="2" x="{pkx_final}" y="{pky_final}" face_x="-2175" face_y="0" tolerance="100.0"/>  
                          
                        <!-- Bote final blindado -->  
                        <RetryUntilSuccessful num_attempts="-1">  
                            <ReactiveFallback>  
                                <Sequence>  
                                    <IsBallClose robot_id="2" distance_threshold="125.0" angle_threshold_deg="15.0"/>  
                                    <KickBall robot_id="2" kick_speed="3.0"/>  
                                </Sequence>  
                                <Sequence>  
                                    <UpdateBallPosition robot_id="2" goal_x="-2175" goal_y="0"   
                                                        ball_x="{bx_final}" ball_y="{by_final}" pre_kick_x="{dummy_x2}" pre_kick_y="{dummy_y2}"   
                                                        is_ready_to_kick="{dummy_ready2}" ball_in_enemy_half="{dummy_adv2}"/>  
                                    <GoToPoint robot_id="2" x="{bx_final}" y="{by_final}" face_x="-2175" face_y="0" tolerance="0.0" planner="straight_line"/>  
                                </Sequence>  
                            </ReactiveFallback>  
                        </RetryUntilSuccessful>  
                          
                        <Repeat num_cycles="-1">  
                            <Sequence>  
                                <Halt reason="gol_marcado"/>  
                                <Sleep msec="100"/>  
                            </Sequence>  
                        </Repeat>  
                    </Sequence>  
                      
                    <Repeat num_cycles="-1">  
                        <Sequence>  
                            <Halt reason="assistindo"/>  
                            <Sleep msec="100"/>  
                        </Sequence>  
                    </Repeat>  

                </Fallback>  
            </ReactiveSequence> 

            <!-- ============================================== -->
            <!-- FASE DE PREPARAÇÃO (RESTRIÇÃO DO STOP)         -->
            <!-- ============================================== -->
            <ReactiveSequence>
                <CheckGCCommand expected="1"/>
                <Fallback>
                    <Sequence>
                        <IsThisNodeID id="1"/>
                        <UpdateBallPosition robot_id="1" goal_x="-1120" goal_y="40" ball_x="{bx1_prep}" ball_y="{by1_prep}" pre_kick_x="{pkx1_prep}" pre_kick_y="{pky1_prep}" is_ready_to_kick="{dr}" ball_in_enemy_half="{da}"/>
                        <GoToPoint robot_id="1" x="{pkx1_prep}" y="{pky1_prep}" face_x="-1120" face_y="40" tolerance="100.0"/>
                    </Sequence>
                    <Sequence>
                        <IsThisNodeID id="2"/>
                        <!-- Na preparação, já aguarda em (-1200, 0) virado para a bola para amortecer com a frente -->
                        <UpdateBallPosition robot_id="2" goal_x="-2175" goal_y="0" ball_x="{bx2_prep}" ball_y="{by2_prep}" pre_kick_x="{dummy_x}" pre_kick_y="{dummy_y}" is_ready_to_kick="{dummy_r}" ball_in_enemy_half="{dummy_a}"/> 
                        <GoToPoint robot_id="2" x="-1200" y="0" face_x="{bx2_prep}" face_y="{by2_prep}" tolerance="100.0"/>
                    </Sequence>
                </Fallback>
            </ReactiveSequence>

            <!-- ESTADO INATIVO -->
            <Sequence>
                <Halt reason="aguardando_juiz"/>
            </Sequence>

        </ReactiveFallback>
    </BehaviorTree>
</root>