<root main_tree_to_execute="MainTree" BTCPP_format="4">
  
  <BehaviorTree ID="MainTree">
    <ReactiveFallback name="MasterStrategy">
      
      <!-- 1. BOTÃO DE PARAR (STOP - Comando 1) -->
      <Sequence name="StopBranch">
        <CheckGCCommand expected="1"/>
        <Halt reason="gc"/>
      </Sequence>

      <!-- 2. JOGO / ATAQUE (Igual ao test_attack) -->
      <Repeat num_cycles="-1">
        <ReactiveSequence name="AttackerRole">
          <!-- Só o robô 2 entra aqui -->
          <IsThisNodeID id="2" />
          
          <!-- Atualiza bola em TEMPO REAL (Tick contínuo) -->
          <UpdateBallPosition robot_id="2"
                              ball_x="{ball_x}" ball_y="{ball_y}" 
                              pre_kick_x="{pkx}" pre_kick_y="{pky}" 
                              is_ready_to_kick="{is_ready}"
                              goal_x="{opponent_goal_x}" goal_y="{opponent_goal_y}" />
          
          <ReactiveFallback name="AttackLogic">
            <!-- Tenta Chutar -->
            <ReactiveSequence name="FinalApproach">
              <IsValueTrue value="{is_ready}" />
              <PrecisionKick robot_id="2" 
                             target_x="{opponent_goal_x}" 
                             target_y="{opponent_goal_y}" 
                             kick_speed="4.5" />
            </ReactiveSequence>
            <!-- Anda para o ponto de preparação (Alvo dinâmico) -->
            <GoToPoint robot_id="2" x="{pkx}" y="{pky}" tolerance="50.0" />
          </ReactiveFallback>
        </ReactiveSequence>
      </Repeat>

      <!-- 3. RESERVAS (Robôs 0 e 1 ficam parados) -->
      <Halt reason="idle"/>

    </ReactiveFallback>
  </BehaviorTree>

</root>